    {
      "id": 5,
      "type": "timeseries",
      "title": "$metric — raw readings",
      "description": "Straight from the hypertable.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
