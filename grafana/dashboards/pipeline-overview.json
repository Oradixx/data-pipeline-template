      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time AS \"time\", device_id AS metric, value\nFROM sensor_readings\nWHERE $__timeFilter(time) AND metric = '$metric' AND device_id IN ($device)\nORDER BY 1"
        }
