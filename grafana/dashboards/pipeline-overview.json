          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT bucket AS \"time\", device_id AS metric, avg_value\nFROM readings_hourly\nWHERE $__timeFilter(bucket) AND metric = '$metric' AND device_id IN ($device)\nORDER BY 1"
