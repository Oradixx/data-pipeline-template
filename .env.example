# Copy to .env (`cp .env.example .env`) and change the passwords. .env is git-ignored.

# --- TimescaleDB ---
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=change-me
POSTGRES_DB=telemetry
POSTGRES_PORT=5432

# Used by `pipeline` when run on your machine (`make migrate`, `make ingest`).
# Inside Docker Compose the host is `db` instead of `localhost` (set in docker-compose.yml).
DATABASE_URL=postgresql://pipeline:change-me@localhost:5432/telemetry

# --- Ingestion ---
SOURCE_DEVICES=5
SOURCE_INTERVAL_S=1.0
BATCH_SIZE=500
BATCH_MAX_WAIT_S=2.0
LOG_LEVEL=INFO

# --- Grafana ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
